{
  "name": "dsag-mealapp-security-cap",
  "version": "0.2.0",
  "private": true,
  "description": "DSAG Meal App – Security Training (CAP + SAPUI5 Freestyle)",
  "scripts": {
    "start": "cds watch",
    "deploy": "cds deploy --to sqlite:db.sqlite",
    "reset-db": "node ./scripts/reset-db.js"
  },
  "dependencies": {
    "@sap/cds": "^9.4.4",
    "@cap-js/sqlite": "^2.0.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9.3.1"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        }
      }
    }
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
