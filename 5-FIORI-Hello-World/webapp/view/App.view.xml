<mvc:View controllerName="hello.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    
  <App>
    <pages>
      <Page id="mainPage" title="Hello World">
        <content>
          <VBox
            alignItems="Center"
            justifyContent="Center"
            class="sapUiSmallMargin">

            <Title text="Hello World 👋" level="H1" />

            <Text
              text="This is a simple SAPUI5 Fiori Hello World app."
              class="sapUiSmallMarginTop" />

            <Image
              src="/img/logoAV.svg"
              width="240px"
              decorative="false"
              alt="logoAV" />

            

          </VBox>
        </content>
      </Page>
    </pages>
  </App>
</mvc:View>